{
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "rust-skills@rust-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-skills-reminder.sh SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-skills-reminder.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(agent-skills:code-reviewer|agent-skills:security-auditor)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reviewer-guidelines.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
